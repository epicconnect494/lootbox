{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "outDir": "./public",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node10",
    "sourceMap": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/frontend/**/*", "src/engine/**/*", "src/models/**/*", "src/animation/**/*", "src/config/**/*"],
  "exclude": ["node_modules", "dist", "tests", "public", "src/index.ts"]
}
